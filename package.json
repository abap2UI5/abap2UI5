{
  "name": "abap2UI5",
  "private": true,
  "version": "1.144.0",
  "description": "Developing UI5 Apps Purely in ABAP.",
  "scripts": {
    "deps": "node node/setup/fetch-deps.mjs",
    "frontend:build": "node tools/build-branches.mjs",
    "frontend:cloud": "node tools/build-branches.mjs cloud",
    "frontend:cloud_v2": "node tools/build-branches.mjs cloud_v2",
    "frontend:standard": "node tools/build-branches.mjs standard",
    "frontend:standard_v2": "node tools/build-branches.mjs standard_v2",
    "frontend:verify": "node tools/verify-branches.mjs",
    "frontend:lint": "npx abaplint frontend/abap/cloud/abaplint.jsonc",
    "check": "npm run deps && npx abaplint",
    "check_visibility": "node .github/scripts/testclass-visibility-gate.mjs",
    "check:naming": "node .github/scripts/object-naming-gate.mjs",
    "check:dynamic": "node .github/scripts/dynamic-name-gate.mjs",
    "check:prose": "node .github/scripts/prose-name-gate.mjs",
    "check:skills": "node .github/scripts/skill-rule-gate.mjs",
    "check:scripts": "node .github/scripts/scripts-gate.mjs",
    "check:toolchain": "node .github/scripts/toolchain-gate.mjs",
    "check:shared": "node .github/scripts/shared-file-gate.mjs",
    "check:mirrors": "node .github/scripts/linter-mirror-gate.mjs",
    "check:samples-md": "node .github/scripts/samples-md-gate.mjs",
    "check:changelog": "node .github/scripts/changelog-gate.mjs",
    "check:changelog-entry": "node .github/scripts/changelog-entry-gate.mjs",
    "backlog": "node .github/scripts/generate-backlog.mjs",
    "backlog:probe": "node .github/scripts/backlog-probe.mjs",
    "backlog:mine": "node .github/scripts/backlog-mine.mjs",
    "backlog:filed": "node .github/scripts/backlog-filed.mjs",
    "check:backlog": "node .github/scripts/generate-backlog.mjs --check",
    "check:version": "node .github/scripts/version-sync-gate.mjs",
    "check:icons": "node .github/scripts/ui5-icon-gate.mjs",
    "check:modules": "node .github/scripts/frontend-module-gate.mjs",
    "check:standard": "npx abaplint .github/abaplint/abap_standard.jsonc",
    "check:cloud": "npx abaplint .github/abaplint/abap_cloud.jsonc",
    "check:js": "npx playwright test -c node/playwright-unit.config.js",
    "check:frozen": "node .github/scripts/frozen-paths-gate.mjs",
    "check:frozen-only": "node .github/scripts/frozen-only-gate.mjs",
    "check:ui5": "node .github/scripts/ui5lint-gate.mjs",
    "check:app2abap": "node .github/scripts/ensure-app-deps.mjs && node .github/scripts/app2abap-gate.mjs",
    "check:frontend": "npm run frontend:build && node tools/check-pages.mjs",
    "check:api": "node .github/scripts/api-snapshot.mjs",
    "check:formatter": "node .github/scripts/formatter-scope-gate.mjs",
    "check:asserts": "node .github/scripts/assertion-gate.mjs",
    "check:specs": "node .github/scripts/spec-inventory-gate.mjs",
    "check:downport": "node .github/scripts/downport-operand-gate.mjs",
    "check:pins": "node .github/scripts/transpile-pins-gate.mjs",
    "check:draftowner": "node .github/scripts/draft-owner-gate.mjs",
    "check:csp": "node .github/scripts/csp-default-gate.mjs",
    "blockers": "node .github/scripts/removal-blockers.mjs",
    "check:release": "node .github/scripts/release-gate.mjs",
    "coverage": "node .github/scripts/coverage-report.mjs",
    "check:abap2ui5": "abap2ui5lint",
    "check:render": "abap2ui5lint --render",
    "check:conventions": "node .github/scripts/conventions-gate.mjs",
    "check:commands": "node .github/scripts/agents-commands-gate.mjs",
    "check:format": "npx abaplint .github/abaplint/auto_abaplint_fix.jsonc",
    "check:eslint": "eslint .",
    "fmt:chains": "abap2ui5lint --fix",
    "check:abapgit": "node .github/scripts/abapgit-format-gate.mjs",
    "check:atc": "node .github/scripts/extended-check-gate.mjs",
    "check:cause": "node .github/scripts/exception-cause-gate.mjs",
    "gates": "node .github/scripts/run-gates.mjs",
    "verify": "node .github/scripts/run-verify.mjs",
    "verify:full": "node .github/scripts/run-verify.mjs --full",
    "syfixes": "node node/setup/downport-fix.mjs syfixes",
    "strip_trailing_ws": "node node/setup/downport-fix.mjs strip-trailing-ws",
    "abaplintpathfix": "node node/setup/downport-fix.mjs abaplint-path",
    "downport_config": "node node/setup/downport-fix.mjs downport-config",
    "downport": "npm run deps && node node/setup/patch-abaplint-downport.mjs && node node/setup/downport-fix.mjs copy-src && npm run downport_config && abaplint --fix .github/abaplint/downport_run.jsonc && npm run syfixes && npm run strip_trailing_ws",
    "auto_downport": "npm run downport && cp -r node/downport/. src/ && cp -f .github/abaplint/abap_702.jsonc abaplint.jsonc && npm run abaplintpathfix",
    "auto_app2abap": "node tools/app2abap/trans2abap.js",
    "app2abap": "npm --prefix app run format && npm run auto_app2abap && npm run auto_abaplint",
    "auto_abaplint": "npx abaplint .github/abaplint/auto_abaplint_fix.jsonc --fix",
    "auto_transpile": "node node/setup/downport-fix.mjs prepare-transpile && abap_transpile ./node/setup/abap_transpile.json",
    "rename": "abaplint .github/abaplint/rename.jsonc --rename",
    "express": "node node/srv/express.mjs",
    "unit": "node node/setup/require-transpiled.mjs && node node/output/index.mjs",
    "test": "npm run unit && npm run check:js",
    "check:guide": "node .github/scripts/check-guide-api.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5/abap2UI5.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/abap2UI5/abap2UI5/issues"
  },
  "homepage": "https://abap2UI5.org",
  "devDependencies": {
    "@abap2ui5/linter": "^0.6.1",
    "@abaplint/cli": "^2.120.38",
    "@abaplint/database-sqlite": "^2.13.40",
    "@abaplint/runtime": "^2.13.64",
    "@abaplint/transpiler-cli": "^2.13.64",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@ui5/cli": "^4.0.62",
    "acorn": "^8.14.0",
    "c8": "^12.0.0",
    "eslint": "^10.9.1",
    "express": "^5.2.1",
    "globals": "^17.11.0",
    "terser": "^5.51.2"
  }
}
