{
  "_version": "1.65.0",
  "sap.app": {
    "id": "z2ui5",
    "type": "application",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "abap2UI5",
    "description": "The abap2UI5 frontend - loaded from the backend as a bundle by the embed control, never started as an app of its own",
    "dataSources": {
      "http": {
        "uri": "/sap/bc/z2ui5",
        "type": "JSON"
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.71.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "services": {
      "ShellUIService": {
        "factoryName": "sap.ushell.ui5service.ShellUIService",
        "lazy": true
      }
    },
    "rootView": {
      "viewName": "z2ui5.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    },
    "resourceRoots": {
      "z2ui5_cci": "../z2ui5_cci/",
      "z2ui5_ccc": "../z2ui5_ccc/"
    }
  }
}
