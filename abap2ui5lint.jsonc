{
  // The abap2UI5-linter, run against the framework's OWN app classes — the
  // ones under src/01/04 and src/02 plus the test-server apps under node/srv.
  // (The run prints how many it found and how many of them build a view; a
  // count written here would be one more number nothing checks.)
  //
  // Those apps are what an app developer copies from: `z2ui5_cl_ui5_app_hi_world`
  // is the worked example in docs/agents/building-apps.md, and the start app is
  // the first abap2UI5 view most people ever see. So the corpus this repository
  // ships to be imitated is checked with the tool it ships for imitators.
  //
  // This is NOT a gate over the framework's engine: `src/01/01`–`src/01/03`,
  // `src/00` and `src/99` build no views and the linter has nothing to say
  // about them. abaplint (`npm run check`) remains the ABAP gate for all of it.
  "$schema": "./node_modules/@abap2ui5/linter/data/abap2ui5lint.schema.json",

  "paths": ["src", "node/srv"],

  // src/99 is FROZEN (AGENTS.md, "The frozen package"): it ships so existing
  // downstream installations keep compiling, its production code is not
  // changed, and it "is out of scope for reviews and audits". This gate is an
  // audit, so it stops at the boundary — not collected at all, rather than
  // collected and then excused rule by rule.
  //
  // It became visible only when the 17 popup classes in src/99/02 were ported
  // off the retired builder onto z2ui5_cl_ui5_view_builder: the linter can
  // read a view built with the current builder, so a package it previously had
  // nothing to say about arrived with 16 findings in one run (3 errors, 12
  // warnings, 1 hint). They are real and none of them is actionable HERE:
  //
  //   pop_demo_output     unknown-icon        sap-icon://textFormatting
  //   pop_image_editor    sapui5-only-control sap.suite.ui.commons.imageeditor.*
  //   pop_get_range(_m)   member-too-new      sap.m.List noData @1.101
  //   pop_to_inform       icon-too-new        sap-icon://information @1.80
  //   pop_file_ul, pop_get_range(_m), pop_to_select
  //                       obsolete-model-update  popup_model_update( )
  //   5x missing-on-navigated-branch, 1x missing-accessibility
  //
  // Fixing any of them edits frozen production code and changes behaviour on
  // systems that installed it; the port did not (it builds the same XML). So
  // the findings are recorded here instead. Drop this `ignore` the day src/99
  // stops being frozen, and fix the list.
  "ignore": ["/src/99/"],

  // The oldest release abap2UI5 supports — the same floor the samples are held
  // to, and the reason it matters here is that a shipped app demonstrating a
  // post-1.71 control would break on exactly the systems this floor exists for.
  "ui5": "1.71",
  "distribution": "openui5",

  "rules": {
    /* `frozen-view-builder` used to carry an `exclude` for /src/99/ here: the
     * rule collects a class that builds its view with z2ui5_cl_xml_view
     * instead of skipping it, and that lit up the 17 popup classes of
     * src/99/02. Both the reason and the exclusion are gone — those classes
     * build with z2ui5_cl_ui5_view_builder now, and the package is not
     * collected at all (`ignore` above). Anything OUTSIDE src/99 is still
     * reported: an app on the retired builder is exactly what the rule exists
     * to catch. */

    /* The e2e host of sample 338 (node/srv/zcl_tst_host) opens its builder
     * in one method and stringifies the page from an attribute in another,
     * after a sub-app created BY NAME has built into it - the shape of the
     * nested-view samples. The reconstruction replays only the methods that
     * open a factory and emits a document where a known handle is
     * stringified, so this class yields no document and no helper token:
     * "no view reconstructed" instead of the skip its 19 dynamic
     * neighbours get. Waived here, where the linter reports a stale waiver
     * the moment the render comes back clean; the gap itself (a factory
     * opened in one method, its handle stringified in another, is not
     * statically reconstructable and should skip) belongs to the linter. */
    "render-error": { "exclude": ["/node/srv/zcl_tst_host."] },

    // The reason the linter is a dependency here at all. It replaces
    // .github/scripts/chain-format-gate.mjs, which was this rule reimplemented
    // locally and kept byte-identical in three repositories by hand — the
    // duplication the rule itself was invented to remove.
    //
    // Opt-in by design (OPT_IN in the linter's findings.mjs): it encodes ONE
    // house style, and this repository is where that style is defined
    // (docs/agents/building-apps.md, "Formatting the chain", and the
    // view-chain-layout skill). `npm run fmt:chains` applies it.
    "chain-house-layout": { "severity": "warning" },

    // Off, and only here: the rule tells an APP not to name an object outside
    // the released `src/02` package, because those get renamed without notice.
    // These app classes ARE the framework — `z2ui5_cl_ui5_app_start` reaching
    // for `z2ui5_cl_ui5_srv_draft` or `z2ui5_cl_ui5_user_exit` is a shipped app
    // calling its own engine, which is what it is for, and there is no release
    // boundary between them to cross. Leaving it on would train the reader to
    // ignore a rule that is exactly right everywhere else.
    "non-released-api": false
  },

  // No render gate IN THIS CONFIG, because it would be paid for by every job:
  // it needs @abap2ui5/render-runtime (~123 MB of UI5), the shared setup action
  // runs `npm ci` for all of them, and most have nothing to do with views.
  //
  // It does run, though — `npm run check:render` turns it on against this same
  // config, and render-gate.yaml installs the runtime and calls it. That was
  // the gap: the argument for leaving it off used to be that node/srv's
  // Playwright suite already loads these apps, which is true and is not the
  // same test. The suite proves the shipped apps work end to end; the render
  // gate proves every view a class BUILDS survives a real XMLView.create,
  // which is the check this repository asks four other repositories to pass.
  //
  // Measured before it was wired up: 24 files, 5 documents rendered, 19 built
  // in helper methods and skipped, no findings, 9.6 seconds.
  "render": false,

  "failOn": "warning"
}
