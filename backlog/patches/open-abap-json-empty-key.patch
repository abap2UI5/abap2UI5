From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 16 Sep 2026 09:10:00 +0000
Subject: [PATCH] cl_sxml_string_reader: an object member with an EMPTY key
 keeps its name attribute

A JSON object member whose key is the empty string - `{"":1}` - reached the
reader as an element with NO attributes at all, indistinguishable from an
array element, which legitimately has no key. `ty_node-key` is a string, so
"there was no key" and "the key was empty" are the same value, and
lcl_reader=>initialize decided on `IF <ls_parsed>-key IS NOT INITIAL`.

The parser can tell the two apart - traverse_object always passes a key and
traverse_array never does - so the distinction only has to survive the node
table. `has_key` carries it, and the reader attaches the `name` attribute
whenever there WAS a key, empty or not.

Why it matters beyond correctness: a consumer that reads the attribute back
with `READ TABLE ... INDEX 1` and ASSERTs on the subrc gets an ASSERTION_FAILED
instead of the error it would raise two lines further down. ajson does exactly
that (lcl_json_parser=>_parse: `ASSERT sy-subrc = 0 AND lo_attr->qname-name =
'name'.` immediately above `IF <item>-name IS INITIAL. raise( 'Node without
name (maybe not JSON)' ).`), so on a real system `{"":1}` is a catchable
CX_AJSON_ERROR and under open-abap it is an uncatchable dump. For a web
framework parsing a request body that is the difference between a 500 with a
message and a response with no body, no status and no headers at all.

Measured in abap2UI5: with this change the four empty-key request shapes go
from an uncaught ASSERTION_FAILED to a clean 500, and its transpiled unit
suite stays green (1271 tests).
---
diff --git a/src/sxml/cl_sxml_string_reader.clas.locals_imp.abap b/src/sxml/cl_sxml_string_reader.clas.locals_imp.abap
index 09cf774..ca67fd0 100644
--- a/src/sxml/cl_sxml_string_reader.clas.locals_imp.abap
+++ b/src/sxml/cl_sxml_string_reader.clas.locals_imp.abap
@@ -6,6 +6,7 @@ CLASS lcl_json_parser DEFINITION.
              type  TYPE if_sxml_node=>node_type,
              name  TYPE string,
              key   TYPE string,
+             has_key TYPE abap_bool,
              value TYPE string,
            END OF ty_node.
 
@@ -24,20 +25,24 @@ CLASS lcl_json_parser DEFINITION.
         iv_type  TYPE if_sxml_node=>node_type
         iv_name  TYPE string OPTIONAL
         iv_key   TYPE string OPTIONAL
+        iv_has_key TYPE abap_bool DEFAULT abap_false
         iv_value TYPE string OPTIONAL.
 
     METHODS traverse
       IMPORTING
         iv_json TYPE any
-        iv_key  TYPE string OPTIONAL.
+        iv_key  TYPE string OPTIONAL
+        iv_has_key TYPE abap_bool DEFAULT abap_false.
     METHODS traverse_object
       IMPORTING
         iv_json TYPE any
-        iv_key  TYPE string OPTIONAL.
+        iv_key  TYPE string OPTIONAL
+        iv_has_key TYPE abap_bool DEFAULT abap_false.
     METHODS traverse_array
       IMPORTING
         iv_json TYPE any
-        iv_key  TYPE string OPTIONAL.
+        iv_key  TYPE string OPTIONAL
+        iv_has_key TYPE abap_bool DEFAULT abap_false.
 
 ENDCLASS.
 
@@ -76,6 +81,7 @@ CLASS lcl_json_parser IMPLEMENTATION.
     ls_node-type = iv_type.
     ls_node-name = iv_name.
     ls_node-key = iv_key.
+    ls_node-has_key = iv_has_key.
     ls_node-value = iv_value.
     APPEND ls_node TO mt_nodes->*.
   ENDMETHOD.
@@ -90,10 +96,12 @@ CLASS lcl_json_parser IMPLEMENTATION.
     CASE lv_type.
       WHEN 'object'.
         traverse_object( iv_json = iv_json
-                         iv_key  = iv_key ).
+                         iv_key  = iv_key
+                         iv_has_key = iv_has_key ).
       WHEN 'array'.
         traverse_array( iv_json = iv_json
-                        iv_key  = iv_key ).
+                        iv_key  = iv_key
+                        iv_has_key = iv_has_key ).
       WHEN 'string' OR 'boolean' OR 'number' OR 'null'.
         WRITE '@KERNEL iv_json = iv_json.value + "";'.
 
@@ -108,7 +116,8 @@ CLASS lcl_json_parser IMPLEMENTATION.
 
         append( iv_type = if_sxml_node=>co_nt_element_open
                 iv_name = lv_type
-                iv_key  = iv_key ).
+                iv_key  = iv_key
+                iv_has_key = iv_has_key ).
         IF lv_type <> 'null'.
           append( iv_type  = if_sxml_node=>co_nt_value
                   iv_value = iv_json ).
@@ -133,7 +142,8 @@ CLASS lcl_json_parser IMPLEMENTATION.
 
     append( iv_type = if_sxml_node=>co_nt_element_open
             iv_name = 'array'
-            iv_key  = iv_key ).
+            iv_key  = iv_key
+            iv_has_key = iv_has_key ).
 
     DO lv_length TIMES.
       lv_index = sy-index - 1.
@@ -155,13 +165,15 @@ CLASS lcl_json_parser IMPLEMENTATION.
 
     append( iv_type = if_sxml_node=>co_nt_element_open
             iv_name = 'object'
-            iv_key  = iv_key ).
+            iv_key  = iv_key
+            iv_has_key = iv_has_key ).
 
     WRITE '@KERNEL for (const k of Object.keys(parsed)) {'.
     WRITE '@KERNEL   lv_key.set(k);'.
     WRITE '@KERNEL   lv_value = {value: parsed[k]};'.
     traverse( iv_json = lv_value
-              iv_key  = lv_key ).
+              iv_key  = lv_key
+              iv_has_key = abap_true ).
     WRITE '@KERNEL };'.
 
     append( iv_type = if_sxml_node=>co_nt_element_close
@@ -359,7 +371,7 @@ CLASS lcl_reader IMPLEMENTATION.
       CASE <ls_parsed>-type.
         WHEN if_sxml_node=>co_nt_element_open.
           CLEAR lt_attributes.
-          IF <ls_parsed>-key IS NOT INITIAL.
+          IF <ls_parsed>-has_key = abap_true.
             CREATE OBJECT li_attribute TYPE lcl_attribute
               EXPORTING
                 name       = 'name'
-- 
2.43.0
