--- /dev/null
+++ b/packages/core/src/rules/literal_no_separator.ts
@@ -0,0 +1,72 @@
+import {ABAPFile} from "../abap/abap_file";
+import {Issue} from "../issue";
+import {ABAPRule} from "./_abap_rule";
+import {BasicRuleConfig} from "./_basic_rule_config";
+import {IRuleMetadata, RuleTag} from "./_irule";
+import {StringToken, StringTemplate, StringTemplateEnd} from "../abap/1_lexer/tokens";
+
+export class LiteralNoSeparatorConf extends BasicRuleConfig {
+}
+
+export class LiteralNoSeparator extends ABAPRule {
+
+  private conf = new LiteralNoSeparatorConf();
+
+  public getMetadata(): IRuleMetadata {
+    return {
+      key: "literal_no_separator",
+      title: "Separator after literal",
+      shortDescription: `Checks that a closing string literal is followed by a separator.`,
+      extendedInformation: `ABAP requires a blank or an equivalent character (":", ",", ".") after a
+closing literal. Without one the statement does not parse on a system:
+
+"There must be a space or equivalent character (":", ",", ".") after \`abc\`."
+
+The text symbol form 'text'(001) is not reported, the parenthesis is not a name character.`,
+      tags: [RuleTag.Syntax, RuleTag.SingleFile],
+      badExample: "m( a = `x`b = `y` ).",
+      goodExample: "m( a = `x` b = `y` ).",
+    };
+  }
+
+  private getMessage(): string {
+    return "There must be a space or equivalent character after the literal";
+  }
+
+  public getConfig() {
+    return this.conf;
+  }
+
+  public setConfig(conf: LiteralNoSeparatorConf) {
+    this.conf = conf;
+  }
+
+  public runParsed(file: ABAPFile) {
+    const issues: Issue[] = [];
+
+    for (const statement of file.getStatements()) {
+      const tokens = statement.getTokens();
+      for (let i = 0; i < tokens.length - 1; i++) {
+        const token = tokens[i];
+        if (!(token instanceof StringToken
+            || token instanceof StringTemplate
+            || token instanceof StringTemplateEnd)) {
+          continue;
+        }
+        const next = tokens[i + 1];
+        if (token.getRow() !== next.getRow()) {
+          continue;
+        }
+        if (token.getEnd().getCol() !== next.getStart().getCol()) {
+          continue;
+        }
+        if (!/^[A-Za-z0-9_]/.test(next.getStr())) {
+          continue;
+        }
+        issues.push(Issue.atToken(file, next, this.getMessage(), this.getMetadata().key, this.conf.severity));
+      }
+    }
+
+    return issues;
+  }
+}
diff --git a/packages/core/test/rules/literal_no_separator.ts b/packages/core/test/rules/literal_no_separator.ts
new file mode 100644
index 0000000..19bd252
--- /dev/null
+++ b/packages/core/test/rules/literal_no_separator.ts
@@ -0,0 +1,26 @@
+import {LiteralNoSeparator} from "../../src/rules/literal_no_separator";
+import {testRule} from "./_utils";
+
+const tests = [
+  // the three delimiters, each running straight into a name
+  {abap: "m( a = `x`b = `y` ).", cnt: 1},
+  {abap: "m( a = 'x'b = `y` ).", cnt: 1},
+  {abap: "m( a = |x|b = `y` ).", cnt: 1},
+
+  // the fix
+  {abap: "m( a = `x` b = `y` ).", cnt: 0},
+  {abap: "m( a = 'x' b = `y` ).", cnt: 0},
+  {abap: "m( a = |x| b = `y` ).", cnt: 0},
+
+  // what may legally follow a literal
+  {abap: "WRITE 'text'(001).", cnt: 0},
+  {abap: "WRITE `it``s`.", cnt: 0},
+  {abap: "WRITE 'it''s'.", cnt: 0},
+  {abap: "DATA(a) = `x` && `y`.", cnt: 0},
+  {abap: "WRITE `x`. \" a comment naming `x` right after", cnt: 0},
+  {abap: "* a comment with `x`y in it", cnt: 0},
+  {abap: "m( a = `x`).", cnt: 0},
+  {abap: "WRITE |{ a }|.", cnt: 0},
+];
+
+testRule(tests, LiteralNoSeparator);
