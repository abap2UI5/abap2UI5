From caf698852c7c4150a45e74faccd07048e446f654 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 29 Sep 2026 21:03:36 +0000
Subject: [PATCH] LOOP: no row index -1, and no read past the end after a
 DELETE

Two ways a LOOP read a row that is not there:

- USING KEY k with a WHERE that does not name k's first field
  (LOOP AT t USING KEY k WHERE b = 2, k over a): determineFromTo
  answered from = 0 where the branch without topEquals answers 1, the
  loop started at index -1 and threw "Cannot read properties of undefined
  (reading 'get')". from is 1-based now in both branches.
- USING KEY primary_key (or a dynamic name holding it) with a DELETE in
  the body: loopTo is refreshed only for a LOOP without USING KEY, and
  the guard `index > array.length` let index reach array.length. With a
  WHERE that threw the same TypeError; without one the last row was
  visited twice (1/1 1/2 1/2 instead of 1/1 1/2). The guard is `>=`.
---
 packages/runtime/src/statements/loop.ts | 11 +++--
 test/statements/loop.ts                 | 53 +++++++++++++++++++++++++
 2 files changed, 61 insertions(+), 3 deletions(-)

diff --git a/packages/runtime/src/statements/loop.ts b/packages/runtime/src/statements/loop.ts
index 745389d..b9bb6d0 100644
--- a/packages/runtime/src/statements/loop.ts
+++ b/packages/runtime/src/statements/loop.ts
@@ -24,14 +24,17 @@ function determineFromTo(array: readonly any[], topEquals: topType | undefined,
     return {from: 1, to: array.length};
   }
 
-  let from = 0;
+  // 1-based, as the branch without topEquals above answers: a WHERE that
+  // does not name the key's first field narrows nothing, and must not start
+  // the loop at row index -1
+  let from = 1;
   let to = array.length;
 
 // todo: multi field
   const keyField = key.keyFields[0].toLowerCase();
   const keyValue = topEquals[keyField];
   if (keyField && keyValue) {
-    from = binarySearchFrom(array, from, to, keyField, keyValue);
+    from = binarySearchFrom(array, 0, to, keyField, keyValue);
     to = binarySearchTo(array, from, to, keyField, keyValue);
 //    console.dir("from: " + from + ", to: " + to);
   }
@@ -168,7 +171,9 @@ export async function* loop(table: Table | HashedTable | FieldSymbol | undefined
     const isStructured = array[0] instanceof Structure;
 
     while (loopController.index < loopController.loopTo) {
-      if (loopController.index > array.length) {
+      // the body may have deleted rows: never read past the end, where
+      // array[array.length] is undefined
+      if (loopController.index >= array.length) {
         break;
       }
       const current = array[loopController.index];
diff --git a/test/statements/loop.ts b/test/statements/loop.ts
index e5c7655..ede4c69 100644
--- a/test/statements/loop.ts
+++ b/test/statements/loop.ts
@@ -1315,4 +1315,57 @@ ENDLOOP.`;
     */
   });
 
+
+  it("LOOP USING KEY WHERE on a field that is not the key's", async () => {
+    const code = `
+TYPES: BEGIN OF ty, a TYPE i, b TYPE i, END OF ty.
+DATA t TYPE STANDARD TABLE OF ty WITH NON-UNIQUE KEY a b
+       WITH NON-UNIQUE SORTED KEY k COMPONENTS a.
+DATA r TYPE ty.
+t = VALUE #( ( a = 1 b = 0 ) ( a = 2 b = 2 ) ( a = 3 b = 0 ) ( a = 1 b = 2 ) ).
+LOOP AT t INTO r USING KEY k WHERE b = 2.
+  WRITE / |{ r-a }/{ r-b }|.
+ENDLOOP.`;
+    const js = await run(code);
+    const f = new AsyncFunction("abap", js);
+    await f(abap);
+    expect(abap.console.get()).to.equal("1/2\n2/2");
+  });
+
+  it("LOOP USING KEY primary_key, DELETE in the body", async () => {
+    const code = `
+TYPES: BEGIN OF ty, a TYPE i, b TYPE i, END OF ty.
+DATA s TYPE SORTED TABLE OF ty WITH NON-UNIQUE KEY a.
+DATA r TYPE ty.
+s = VALUE #( ( a = 1 b = 1 ) ( a = 1 b = 2 ) ( a = 2 b = 3 ) ).
+LOOP AT s INTO r USING KEY primary_key.
+  WRITE / |{ r-a }/{ r-b }|.
+  IF lines( s ) = 3.
+    DELETE s INDEX 3.
+  ENDIF.
+ENDLOOP.`;
+    const js = await run(code);
+    const f = new AsyncFunction("abap", js);
+    await f(abap);
+    expect(abap.console.get()).to.equal("1/1\n1/2");
+  });
+
+  it("LOOP USING KEY (name) WHERE, name primary_key, DELETE in the body", async () => {
+    const code = `
+TYPES: BEGIN OF ty, a TYPE i, b TYPE i, END OF ty.
+DATA s TYPE SORTED TABLE OF ty WITH NON-UNIQUE KEY a.
+DATA r TYPE ty.
+DATA name TYPE string VALUE 'primary_key'.
+s = VALUE #( ( a = 1 b = 1 ) ( a = 1 b = 2 ) ( a = 2 b = 3 ) ).
+LOOP AT s INTO r USING KEY (name) WHERE a = 1.
+  WRITE / |{ r-a }/{ r-b }|.
+  IF lines( s ) = 3.
+    DELETE s INDEX 3.
+  ENDIF.
+ENDLOOP.`;
+    const js = await run(code);
+    const f = new AsyncFunction("abap", js);
+    await f(abap);
+    expect(abap.console.get()).to.equal("1/1\n1/2");
+  });
 });
\ No newline at end of file
