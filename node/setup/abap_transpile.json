{
  "input_folder": "node/downport",
  "output_folder": "node/output",
  "libs": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/node/deps/open-abap-core"
    },
    {
      "url": "https://github.com/open-abap/express-icf-shim",
      "folder": "/node/deps/express-icf-shim"
    }
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": false,
    "addFilenames": true,
    "addCommonJS": true,
    "setup": {
      "filename": "../setup/setup.mjs",
      "preFunction": "setup"
    },
    "unknownTypes": "runtimeError",
    "populateTables": {
      "reposrc": false
    },
    "keywords": ["return", "in", "class", "for", "delete", "var", "with"],
    "skip": [
      {"object": "Z2UI5_CL_UTIL_EXT", "class": "ltcl_source_ops", "method": "source_get_method_basic", "note": "reads method source from REPOSRC, not populated in NodeJS runtime"},
      {"object": "Z2UI5_CL_UTIL", "class": "ltcl_time_ops", "method": "add_seconds", "note": "NodeJS cl_abap_tstmp carries fractional seconds, second-exact diff asserts are off by one"},
      {"object": "Z2UI5_CL_UTIL", "class": "ltcl_time_ops", "method": "diff_seconds", "note": "NodeJS cl_abap_tstmp carries fractional seconds, second-exact diff asserts are off by one"},
      {"object": "Z2UI5_CL_AJSON", "class": "ltcl_parser_test", "method": "unicode_characters", "note": "CL_ABAP_CONV_IN_CE=>uccpi dynamic call not supported in NodeJS runtime"},
      {"object": "Z2UI5_CL_AJSON", "class": "ltcl_writer_test", "method": "set_timestampl", "note": "NodeJS timestamp precision is milliseconds, ABAP expects microseconds"},
      {"object": "Z2UI5_CL_AJSON", "class": "ltcl_abap_to_json", "method": "set_value_timestampl", "note": "NodeJS timestamp precision is milliseconds, ABAP expects microseconds"},
      {"object": "Z2UI5_CL_UI5_SRV_MODEL", "class": "ltcl_test_app_root4", "method": "test_tab_ref_gen", "note": "S-RTTI serialization calls CL_ABAP_TYPEDESCR=>describe_by_name with a dynamic type name, not supported in NodeJS runtime"}
    ]
  }
}
