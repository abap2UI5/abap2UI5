{
    // cloud/src/03 - what the branch `cloud` carries in place of src/03
    // (tools/build-cloud.mjs): the HTTP service, its handler on
    // if_http_service_extension and the IAM objects. Linted where it lives,
    // against the framework for the one call the handler makes; the rest of
    // that branch is src/00 to src/02 and src/99, which abap_cloud.jsonc
    // lints. open-abap-core carries the interface and is pinned already - the
    // released-API dependency of the other configs is its intersection with
    // 7.02, where an HTTP service does not exist.
    "global": {
      "files": "/../../cloud/src/03/**/*.*"
    },
    "dependencies": [
      {
        "url": "https://github.com/open-abap/open-abap-core",
        "folder": "/../../node/deps/open-abap-core",
        "files": "/src/**/*.*"
      },
      {
        "folder": "/../../src",
        "files": "/0[0-2]/**/*.*"
      }
    ],
    "syntax": {
      "version": "Cloud",
      "errorNamespace": "."
    },
    "rules": {
      "begin_end_names": true,
      "check_include": true,
      "check_syntax": true,
      "global_class": true,
      "implement_methods": true,
      "method_implemented_twice": true,
      "parser_error": true,
      "superclass_final": true,
      "unknown_types": true,
      "xml_bom": true,
      "xml_consistency": true
    }
  }
