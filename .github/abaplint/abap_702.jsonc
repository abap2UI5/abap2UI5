{
    "global": {
      "files": "/../../src/**/*.*"
    },
    "dependencies": [
      {
        "url": "https://github.com/open-abap/open-abap-core",
        "folder": "/../../node/deps/open-abap-core",
        "files": "/src/**/*.*"
      }
    ],
    "syntax": {
      "version": "v702",
      "errorNamespace": "."
    },
    "rules": {
      "downport": true,
      "begin_end_names": true,
      "check_ddic": true,
      "check_include": true,
      "check_syntax": true,
      "global_class": true,
      "definitions_top": true,
      "implement_methods": true,
      // the 7.02 editor stores 255 characters a line and cuts the rest on
      // import - a cut literal fails activation (#2947). The downport is
      // what makes such lines: it joins a multi-line && chain into one
      "line_length": {
        "length": 255
      },
      "method_implemented_twice": true,
      "parser_error": true,
      "superclass_final": true,
      "unknown_types": true,
      "xml_bom": true,
      "xml_consistency": true
    }
  }
