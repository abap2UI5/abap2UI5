{
  "global": {
    // src/99 is deliberately NOT listed: historical only (see AGENTS.md),
    // never analyzed or fixed
    "files": [
      "/../../src/00/**/*.*",
      "/../../src/01/**/*.*",
      "/../../src/02/**/*.*",
      "/../../src/*.*"
    ],
    "noIssues": [ "/src/00" ]
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/../../node/deps/steampunk-2305-api-intersect-702",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "."
  },
  "rules": {

    "in_statement_indentation": true,
    "indentation": true,
    "double_space": true,
    "align_parameters": true,
    "align_pseudo_comments": false,
    "align_type_expressions": true,
    "keyword_case": true,
    "contains_tab": true,
    "colon_missing_space": true,
    // off: --fix breaks every multi-parameter call onto one line per parameter,
    // which pulls the view-builder chains apart - there one CALL belongs on one
    // line, arguments included, and the indentation carries the XML nesting. The
    // active abaplint.jsonc has the rule off as well, so this only stops the
    // scheduled auto-format from undoing it again.
    "line_break_multiple_parameters": false,
    "line_only_punc": true,
    "max_one_method_parameter_per_line": true,
    "sequential_blank": true,
    "whitespace_end": true,
    "space_before_colon": true,
    "space_before_dot": true,
    "commented_code": false

  }
}
