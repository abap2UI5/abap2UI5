{
  "global": {
    // src/99 is deliberately NOT listed: its production code is frozen
    // (check_gates.yaml) - an autofix touching it could never merge
    "files": [
      "/../../src/00/**/*.*",
      "/../../src/01/**/*.*",
      "/../../src/02/**/*.*",
      "/../../src/*.*"
    ],
    "noIssues": [ "/src/00" ]
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/../../node/deps/steampunk-2305-api-intersect-702",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "."
  },
  "rules": {

    "in_statement_indentation": true,
    "indentation": true,
    "double_space": true,
    // The two shipped apps write the view builder's a( ) as one line per
    // attribute - `n` and its value side by side, value column aligned. Both
    // rules below undo that: line_break_multiple_parameters splits any call
    // with more than one parameter, align_parameters then re-indents the
    // pieces. Excluded for these two files only, so the rest of the repo keeps
    // being formatted as before.
    "align_parameters": {
      "exclude": ["z2ui5_cl_ui5_app_start\\.clas\\.abap$", "z2ui5_cl_ui5_app_hi_world\\.clas\\.abap$"]
    },
    "align_pseudo_comments": false,
    "align_type_expressions": true,
    "keyword_case": true,
    "contains_tab": true,
    "colon_missing_space": true,
    "line_break_multiple_parameters": {
      "exclude": ["z2ui5_cl_ui5_app_start\\.clas\\.abap$", "z2ui5_cl_ui5_app_hi_world\\.clas\\.abap$"]
    },
    "line_only_punc": true,
    "max_one_method_parameter_per_line": true,
    "sequential_blank": true,
    "whitespace_end": true,
    "space_before_colon": true,
    "space_before_dot": true,
    "commented_code": false

  }
}
