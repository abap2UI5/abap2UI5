{
    "global": {
      "files": "/../../src/**/*.*",
      // src/03 is Standard ABAP: an ICF node, its handler and a BSP. The
      // branch for ABAP Cloud carries cloud/src/03 in its place
      // (tools/build-cloud.mjs), which abap_service_cloud.jsonc lints
      "exclude": ["/src/03/"]
    },
    "dependencies": [
      {
        "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
        "folder": "/../../node/deps/steampunk-2305-api-intersect-702",
        "files": "/src/**/*.*"
      }
    ],
    "syntax": {
      "version": "Cloud",
      "errorNamespace": "."
    },
    "rules": {
      "downport": true,
      "begin_end_names": true,
      "check_ddic": true,
      "check_include": true,
      "check_syntax": true,
      "global_class": true,
      "definitions_top": false,
      "implement_methods": true,
      "method_implemented_twice": true,
      "parser_error": true,
      "superclass_final": true,
      "unknown_types": true,
      "xml_bom": true,
      "xml_consistency": true
    }
  }
