{
  // Namespace rename config. Renames every artifact from z2ui5 to the
  // placeholder namespace "znamespace"; the build_rename workflow replaces the
  // placeholder with the chosen name (max. 10 characters) before running
  // `abaplint <config> --rename` - see .github/workflows/build_rename.yaml.
  //
  // This is also what the test_rename PR gate runs (`npm run rename`), against
  // the 10-character placeholder, i.e. the worst case the workflow allows. A
  // separate, weaker test config used to exist and let three over-long class
  // names slip through unnoticed - do not reintroduce one.
  //
  // A single catch-all pattern is enough because every object name in src/ is
  // kept at 25 characters or less: generated frontend artifacts are capped by
  // MAX_CLASS_NAME_LENGTH in .github/app2abap/trans2abap.js, hand-written ones
  // by review. 25 + 5 (znamespace is 10 chars, z2ui5 is 5) = the 30-character
  // ABAP limit, hit exactly.
  "global": {
    "files": "/../../src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/../../node/deps/steampunk-2305-api-intersect-702",
      "files": "/src/**/*.*"
    }
  ],
  "rename": {
    "output": "output",
    "patterns": [
      {
        "type": "CLAS|INTF|TABL",
        "oldName": "^z2ui5(.*)$",
        "newName": "znamespace$1"
      }
    ]
  },
  "syntax": {
    "version": "v750",
    "errorNamespace": "."
  },
  "rules": {
    "allowed_object_types": {
      "allowed": [
        "CLAS",
        "DEVC",
        "INTF",
        "TABL"
      ]
    },
    "allowed_object_naming": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
