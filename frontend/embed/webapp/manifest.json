{
  "_version": "1.65.0",
  "sap.app": {
    "id": "z2ui5",
    "type": "application",
    "applicationVersion": {
      "version": "0.1.0"
    },
    "title": "abap2UI5",
    "description": "Runs abap2UI5 apps - the frontend comes from the backend",
    "crossNavigation": {
      "inbounds": {
        "z2ui5-display": {
          "semanticObject": "z2ui5",
          "action": "display",
          "title": "",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "flexBundle": false,
    "dependencies": {
      "minUI5Version": "1.71.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "resourceRoots": {
      "z2ui5.embed": "./thirdparty/z2ui5/embed/",
      "abap2ui5.frontend": "./"
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "config": {
      "defaultApp": "Z2UI5_CL_UI5_APP_START"
    },
    "rootView": {
      "viewName": "abap2ui5.frontend.view.Main",
      "type": "XML",
      "async": true,
      "id": "main"
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "z2ui5"
  }
}
