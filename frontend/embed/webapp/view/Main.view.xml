<mvc:View
    controllerName="abap2ui5.frontend.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:z2ui5="z2ui5.embed"
    displayBlock="true"
    height="100%">
    <MessageStrip
        id="failed"
        type="Error"
        showIcon="true"
        visible="{= !!${start>/error} }"
        text="{start>/error}"
        class="sapUiSmallMargin"/>
    <z2ui5:Container
        id="app"
        endpoint="{start>/endpoint}"
        app="{start>/app}"
        params="{start>/params}"
        ownsPage="true"
        height="100%"
        componentCreated=".onComponentCreated"
        componentFailed=".onComponentFailed"/>
</mvc:View>
