{
  "name": "abap2ui5-page-npm",
  "version": "0.1.0",
  "private": true,
  "description": "The minimal UI5 app that runs abap2UI5, with the embed control from npm: one view with the control - the frontend itself comes from the backend",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "ui5 serve --open index.html",
    "start-local": "ui5 serve --config ui5-local.yaml --open index.html",
    "build": "ui5 build --clean-dest"
  },
  "dependencies": {
    "@abap2ui5/embed-control": "^0.4.0"
  },
  "devDependencies": {
    "@ui5/cli": "^4.0.71",
    "ui5-middleware-simpleproxy": "^3.9.0"
  }
}
